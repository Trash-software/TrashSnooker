<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="trashsoftware.trashSnooker.fxml.settings.SettingsView" spacing="10.0"
      prefWidth="600.0" prefHeight="500.0">

    <padding>
        <Insets topRightBottomLeft="10.0"/>
    </padding>

    <Button fx:id="backButton" text="%backIcon" onAction="#backAction"/>

    <GridPane hgap="10.0" vgap="10.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints percentWidth="30.0"/>
            <ColumnConstraints percentWidth="70.0"/>
        </columnConstraints>

        <VBox spacing="5.0">
            <Hyperlink text="%settingsGeneral" onAction="#generalPageAction"/>
            <Hyperlink text="%settingsGame" onAction="#gamePageAction"/>
            <Hyperlink text="%settingsGraphicsAndSound" onAction="#displayPageAction"/>
        </VBox>

        <ScrollPane fx:id="contentContainer" GridPane.columnIndex="1" GridPane.vgrow="ALWAYS"/>

        <HBox GridPane.rowIndex="1" GridPane.columnIndex="1"
              alignment="CENTER_RIGHT" spacing="10.0">
            <Button fx:id="confirmBtn" text="%confirm" onAction="#confirmAction" disable="true"/>
            <Button text="%cancel" onAction="#cancelAction"/>
        </HBox>
    </GridPane>
</VBox>
